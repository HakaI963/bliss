#!/usr/bin/env python3
"""Bliss clone MCP server.

Lets AI agents (OpenCode, Claude Desktop, any MCP client) drive apps that run
inside Bliss's clone space: install/launch APKs, take screenshots of the hidden
virtual display, OCR it, and inject taps/swipes/text/keys.

It speaks MCP (JSON-RPC 2.0, one message per line over stdio) and relays every
command to the running Bliss app through its file bridge: /bliss/bridge (bound
into proot distros) or /data/data/com.nopiece.bliss/files/clone/bridge.
"""

import base64
import json
import os
import shutil
import sys
import time
import uuid

BRIDGE_CANDIDATES = [
    os.environ.get("BLISS_CLONE_DIR", ""),
    "/bliss/bridge",
    "/data/data/com.nopiece.bliss/files/clone/bridge",
]

TIMEOUT = float(os.environ.get("BLISS_CLONE_TIMEOUT", "30"))


def find_bridge():
    for d in BRIDGE_CANDIDATES:
        if d and os.path.isdir(os.path.join(d, "req")):
            return d
    for d in BRIDGE_CANDIDATES:
        if d and os.path.isdir(d):
            return d
    return None


BRIDGE = find_bridge()


def bridge_call(cmd, *args, timeout=None):
    """Send a command to Bliss. Returns (ok, payload_text)."""
    if BRIDGE is None:
        return (False, "clone bridge not found - keep the Bliss app open")
    rid = uuid.uuid4().hex
    req = os.path.join(BRIDGE, "req", rid)
    res = os.path.join(BRIDGE, "res", rid)
    try:
        with open(req, "w") as f:
            f.write(cmd + "\n")
            for a in args:
                f.write(str(a) + "\n")
    except OSError as e:
        return (False, "cannot write bridge request: %s" % e)
    deadline = time.time() + (timeout or TIMEOUT)
    while not os.path.exists(res):
        if time.time() > deadline:
            try:
                os.remove(req)
            except OSError:
                pass
            return (False, "timeout waiting for Bliss")
        time.sleep(0.15)
    try:
        with open(res) as f:
            lines = f.read().splitlines()
    except OSError as e:
        return (False, "cannot read bridge response: %s" % e)
    try:
        os.remove(res)
    except OSError:
        pass
    ok = bool(lines) and lines[0] == "OK"
    body = "\n".join(lines[1:]) if len(lines) > 1 else ""
    return (ok, body)


def text_result(text, is_error=False):
    out = {"content": [{"type": "text", "text": text}]}
    if is_error:
        out["isError"] = True
    return out


def call_tool(name, args):
    if name == "bliss_clone_status":
        ok, body = bridge_call("status")
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_list":
        ok, body = bridge_call("list")
        if not ok:
            return text_result("error: " + body, True)
        return text_result(body if body else "(no cloned apps yet)")

    if name == "bliss_clone_install":
        target = str(args.get("path_or_url", "")).strip()
        if not target:
            return text_result("error: path_or_url is required", True)
        if target.startswith("http://") or target.startswith("https://"):
            ok, body = bridge_call("install_url", target, timeout=300)
            return text_result(body if ok else "error: " + body, not ok)
        if not os.path.isfile(target):
            return text_result("error: file not found: %s" % target, True)
        inbox = os.path.join(BRIDGE, "inbox")
        try:
            os.makedirs(inbox, exist_ok=True)
            dest = os.path.join(inbox, os.path.basename(target))
            shutil.copyfile(target, dest)
        except OSError as e:
            return text_result("error: cannot copy APK into bridge: %s" % e, True)
        ok, body = bridge_call("install", "inbox/" + os.path.basename(target), timeout=300)
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_launch":
        ok, body = bridge_call("launch", args.get("package", ""))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_kill":
        ok, body = bridge_call("kill", args.get("package", ""))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_uninstall":
        ok, body = bridge_call("uninstall", args.get("package", ""))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_screenshot":
        maxw = int(args.get("max_width", 720))
        ok, body = bridge_call("screenshot", maxw)
        if not ok:
            return text_result("error: " + body, True)
        path = None
        size = ""
        for line in body.splitlines():
            if line.startswith("FILE "):
                path = line[5:].strip()
            elif line.startswith("SIZE "):
                size = line[5:].strip()
        if not path or not os.path.isfile(path):
            return text_result("error: screenshot payload missing", True)
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError as e:
            return text_result("error: cannot read screenshot: %s" % e, True)
        try:
            os.remove(path)
        except OSError:
            pass
        return {
            "content": [
                {"type": "image", "data": base64.b64encode(data).decode("ascii"),
                 "mimeType": "image/png"},
                {"type": "text", "text": "screenshot %s (display pixels)" % (size or "?")},
            ]
        }

    if name == "bliss_clone_ocr":
        ok, body = bridge_call("ocr", timeout=60)
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_tap":
        ok, body = bridge_call("tap", int(args.get("x", 0)), int(args.get("y", 0)))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_swipe":
        ok, body = bridge_call(
            "swipe",
            int(args.get("x1", 0)), int(args.get("y1", 0)),
            int(args.get("x2", 0)), int(args.get("y2", 0)),
            int(args.get("duration_ms", 300)),
        )
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_text":
        ok, body = bridge_call("text", str(args.get("text", "")))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_key":
        ok, body = bridge_call("key", str(args.get("key", "BACK")))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_list_installed":
        ok, body = bridge_call("list_system", timeout=60)
        if not ok:
            return text_result("error: " + body, True)
        return text_result(body if body else "(no launchable installed apps)")

    if name == "bliss_clone_launch_installed":
        ok, body = bridge_call("launch_system", args.get("package", ""), timeout=60)
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_kill_installed":
        ok, body = bridge_call("kill_system", args.get("package", ""))
        return text_result(body if ok else "error: " + body, not ok)

    if name == "bliss_clone_help":
        return text_result(HELP_TEXT)

    return text_result("error: unknown tool %s" % name, True)


HELP_TEXT = """Bliss clone tools drive apps on a hidden virtual display (phone screen stays free).

