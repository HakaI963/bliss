<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome (themed icon) layer: the same five-petal lotus glyph plus
     sparkle in solid white, scaled 0.68 so the drawing stays inside the
     adaptive-icon safe zone and matches the visual size of the colored
     foreground layer. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.68"
        android:scaleY="0.68"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Outer-left petal -->
        <group
            android:rotation="-40"
            android:pivotX="54"
            android:pivotY="72">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z" />
        </group>

        <!-- Outer-right petal -->
        <group
            android:rotation="40"
            android:pivotX="54"
            android:pivotY="72">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z" />
        </group>

        <!-- Inner-left petal -->
        <group
            android:rotation="-20"
            android:pivotX="54"
            android:pivotY="72">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z" />
        </group>

        <!-- Inner-right petal -->
        <group
            android:rotation="20"
            android:pivotX="54"
            android:pivotY="72">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z" />
        </group>

        <!-- Center petal (drawn last so it sits on top) -->
        <group
            android:rotation="0"
            android:pivotX="54"
            android:pivotY="72">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z" />
        </group>

        <!-- Four-point sparkle, top-right of the flower -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M80,15.5 C80.9,20.4 83,22.4 88.5,24 C83,25.6 80.9,27.6 80,32.5 C79.1,27.6 77,25.6 71.5,24 C77,22.4 79.1,20.4 80,15.5 Z" />
    </group>

</vector>
