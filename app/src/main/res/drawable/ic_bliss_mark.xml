<?xml version="1.0" encoding="utf-8"?>
<!-- Bliss brand mark: a stylized five-petal lotus/blossom.
     Five symmetric petals are one path rotated around the base pivot
     (54,72); each petal fades from white at the base to soft pink at the
     tip. A small four-point sparkle sits at the top-right of the flower.
     Geometric and clean so it stays legible down to 48px. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer-left petal -->
    <group
        android:rotation="-40"
        android:pivotX="54"
        android:pivotY="72">
        <path android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="72"
                    android:endX="54"
                    android:endY="30"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFFFD9F0" />
            </aapt:attr>
        </path>
    </group>

    <!-- Outer-right petal -->
    <group
        android:rotation="40"
        android:pivotX="54"
        android:pivotY="72">
        <path android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="72"
                    android:endX="54"
                    android:endY="30"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFFFD9F0" />
            </aapt:attr>
        </path>
    </group>

    <!-- Inner-left petal -->
    <group
        android:rotation="-20"
        android:pivotX="54"
        android:pivotY="72">
        <path android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="72"
                    android:endX="54"
                    android:endY="30"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFFFD9F0" />
            </aapt:attr>
        </path>
    </group>

    <!-- Inner-right petal -->
    <group
        android:rotation="20"
        android:pivotX="54"
        android:pivotY="72">
        <path android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="72"
                    android:endX="54"
                    android:endY="30"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFFFD9F0" />
            </aapt:attr>
        </path>
    </group>

    <!-- Center petal (drawn last so it sits on top) -->
    <group
        android:rotation="0"
        android:pivotX="54"
        android:pivotY="72">
        <path android:pathData="M54,72 C47.5,58 47,43 54,30 C61,43 60.5,58 54,72 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="72"
                    android:endX="54"
                    android:endY="30"
                    android:startColor="#FFFFFFFF"
                    android:endColor="#FFFFD9F0" />
            </aapt:attr>
        </path>
    </group>

    <!-- Four-point sparkle, top-right of the flower -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M80,15.5 C80.9,20.4 83,22.4 88.5,24 C83,25.6 80.9,27.6 80,32.5 C79.1,27.6 77,25.6 71.5,24 C77,22.4 79.1,20.4 80,15.5 Z" />

</vector>
