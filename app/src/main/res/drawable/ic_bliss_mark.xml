<?xml version="1.0" encoding="utf-8"?>
<!-- Altaris brand mark: one clean four-point sparkle with a small companion dot.
     The whole glyph lives inside the 66dp adaptive-icon safe zone (tips at
     21.5 / 86.5 on the 108 viewport) and reads crisply down to 48px, both on
     the near-black launcher tile and on the app's dark background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main sparkle: soft white, a hint of lavender toward the base. -->
    <path
        android:pathData="M54,21.5 C57.44,40.24 65.47,47.88 86.5,54 C67.76,57.44 60.12,65.47 54,86.5 C50.56,67.76 42.53,60.12 21.5,54 C40.24,50.56 47.88,42.53 54,21.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="21.5"
                android:endX="54"
                android:endY="86.5"
                android:startColor="#FFFDFDFF"
                android:endColor="#FFE7E9F8" />
        </aapt:attr>
    </path>

    <!-- Companion dot: dimmer lavender, keeps the mark feeling alive. -->
    <path
        android:pathData="M77.6,25.9 C80.09,25.9 82.1,27.91 82.1,30.4 C82.1,32.89 80.09,34.9 77.6,34.9 C75.11,34.9 73.1,32.89 73.1,30.4 C73.1,27.91 75.11,25.9 77.6,25.9 Z"
        android:fillColor="#FFB9BDE0" />

</vector>
