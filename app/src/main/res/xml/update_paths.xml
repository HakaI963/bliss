<?xml version="1.0" encoding="utf-8"?>
<!--
  Only the update APK is exposed by the updates provider.

  Narrow on purpose: this URI is handed to the system package installer, and
  nothing else in the app's cache has any business being readable through it.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="updates" path="." />
</paths>
